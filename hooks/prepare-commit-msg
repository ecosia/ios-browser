#!/usr/bin/env python3

import re
import sys
from subprocess import CalledProcessError, check_output

commit_msg_filepath = sys.argv[1]

try:
    branch = check_output(
        ["git", "symbolic-ref", "--short", "HEAD"]
    ).strip().decode()

    regex = r"(?i)([A-Za-z]+[-_]\d+)"
    match = re.search(regex, branch)

    if not match:
        sys.exit(0)

    jira_ticket = match.group(0).upper().replace("_", "-")

    with open(commit_msg_filepath, "r+") as fh:
        commit_msg = fh.read().strip()

        branch_ticket_prefix = re.compile(
            rf"^(?:\[{re.escape(jira_ticket)}\]\s*)+",
            re.IGNORECASE,
        )
        any_ticket_prefix = re.compile(r"^\[[A-Za-z]+-\d+\]\s", re.IGNORECASE)

        if branch_ticket_prefix.match(commit_msg):
            commit_msg = branch_ticket_prefix.sub("", commit_msg).strip()
            updated_commit_msg = f"[{jira_ticket}] {commit_msg}"
        elif any_ticket_prefix.match(commit_msg):
            updated_commit_msg = commit_msg
        else:
            updated_commit_msg = f"[{jira_ticket}] {commit_msg}"

        fh.seek(0, 0)
        fh.write(updated_commit_msg)
        fh.truncate()

except CalledProcessError:
    print("Detached HEAD state detected. Skipping branch name extraction.")
