# Ecosia: Optional local SwiftLint check, off by default (linting is already
# enforced as a CI check step on PRs). Opt in with:
#   export IOS_BROWSER_LINT_ENABLED=true
# Only lints the .swift files actually changed in the commits being pushed
# (relative to what the remote already has), not the whole tree — so dirty,
# unstaged, or unrelated local changes are never linted here.
if [ "$IOS_BROWSER_LINT_ENABLED" = "true" ]; then
    z40=0000000000000000000000000000000000000000
    remote_name="$1"
    changed_files=$(mktemp)

    while read -r local_ref local_sha remote_ref remote_sha; do
        [ "$local_sha" = "$z40" ] && continue  # deleting a branch, nothing to lint

        if [ "$remote_sha" = "$z40" ]; then
            # Branch doesn't exist on the remote yet: diff against where it
            # forked from the default branch instead of its full history.
            base=$(git merge-base "$local_sha" "$remote_name/main" 2>/dev/null)
        else
            base="$remote_sha"
        fi

        [ -n "$base" ] && git diff --name-only --diff-filter=ACMR "$base" "$local_sha" -- '*.swift' >> "$changed_files"
    done < "$refs_input"

    files=$(sort -u "$changed_files")
    rm -f "$changed_files"

    if [ -n "$files" ]; then
        echo "IOS_BROWSER_LINT_ENABLED=true, running SwiftLint on the files being pushed..."
        # shellcheck disable=SC2086
        swiftlint lint --strict --quiet $files
        RESULT=$?

        if [ $RESULT -ne 0 ]; then
            echo "SwiftLint found violations. Fix them, or push with --no-verify to skip."
            exit 1
        fi
    fi
fi

# Ecosia: print the correct compare URL for this push so PRs don't get opened
# against mozilla-mobile/firefox-ios by accident via GitHub's "Compare & pull
# request" banner (which defaults the base repo to the upstream fork parent).
remote_url="$2"
case "$remote_url" in
  *ecosia/ios-browser*)
    # 256-color blue (33, "DodgerBlue") reads clearly on both light and dark terminal
    # backgrounds, unlike the standard ANSI blue (34) which is often too dark to read
    # on dark themes. Only colorize when stdout is a real terminal.
    if [ -t 1 ]; then
      blue='\033[38;5;33m'
      reset='\033[0m'
    else
      blue=''
      reset=''
    fi
    while read -r local_ref local_sha remote_ref remote_sha; do
      z40=0000000000000000000000000000000000000000
      # Only branches get a PR link (skip tags etc.), and strip the refs/heads/
      # prefix rather than everything up to the last "/" so names like
      # "feature/foo" keep their full path instead of becoming "foo".
      case "$local_ref" in
        refs/heads/*)
          if [ "$local_sha" != "$z40" ]; then
            branch=${local_ref#refs/heads/}
            printf '\n'
            printf "${blue}To open a PR, use this link (do NOT use GitHub's banner — it defaults to mozilla-mobile/firefox-ios):${reset}\n"
            printf "${blue}  https://github.com/ecosia/ios-browser/compare/main...%s?expand=1${reset}\n" "$branch"
            printf '\n'
          fi
          ;;
      esac
    done < "$refs_input"
    ;;
esac

exit 0
