+    func waitForCondition(timeout: TimeInterval = 10, condition: () -> Bool) {
+        let timeoutTime = Date.timeIntervalSinceReferenceDate + timeout
+
+        while !condition() {
+            if Date.timeIntervalSinceReferenceDate > timeoutTime {
+                XCTFail("Condition timed out")
+                return
+            }
+
+            wait(0.1)
+        }
+    }
